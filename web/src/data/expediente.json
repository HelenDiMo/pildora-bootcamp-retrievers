 "docs": [
  {
   "id": "forense",
   "titulo": "Informe del forense",
   "tipo": "informe",
   "autor": "Dr. Hargreaves",
   "fecha": "1894-11-15",
   "texto": "Lord Edmund Aldridge fue hallado sin vida en la biblioteca de Marlowe Hall. La muerte se produjo entre las diez y las once de la noche. No hay heridas ni señales de violencia. En la copa de brandy encontré restos de extracto de belladona, una dosis suficiente para detener el corazón en menos de una hora. La ventana de la biblioteca estaba cerrada por dentro y la puerta no había sido forzada.",
   "archivo": "01_informe_forense.md"
  },
  {
   "id": "mayordomo",
   "titulo": "Testimonio del mayordomo",
   "tipo": "testimonio",
   "autor": "Sr. Finch",
   "fecha": "1894-11-15",
   "texto": "Serví el brandy a las nueve y media, como todas las noches, de la licorera que se llena por la tarde. Su señoría estaba solo, leyendo cartas. Poco antes, el secretario, el señor Hale, había salido del despacho muy pálido tras una discusión a gritos con Lord Aldridge. No vi entrar a nadie más en la biblioteca.",
   "archivo": "02_testimonio_mayordomo.md"
  },
  {
   "id": "jardinero",
   "titulo": "Testimonio del jardinero",
   "tipo": "testimonio",
   "autor": "Tom Brewer",
   "fecha": "1894-11-15",
   "texto": "Sombra, el lebrel de la casa, no ladró aquella noche cuando alguien cruzó el jardín hacia la puerta de servicio. Y ese perro ladra a todo el que no conoce, incluso al cartero. Yo estaba en la caseta de las herramientas y lo oí todo: ni un solo ladrido. Quien fuese, el animal ya lo conocía de sobra.",
   "archivo": "03_testimonio_jardinero.md"
  },
  {
   "id": "cocinera",
   "titulo": "Testimonio de la cocinera",
   "tipo": "testimonio",
   "autor": "Sra. Dalton",
   "fecha": "1894-11-15",
   "texto": "Desde la cocina vi luz en la biblioteca a las diez y cuarto. La luz seguía encendida a medianoche, cuando subí a acostarme. No oí nada raro, solo el reloj del vestíbulo dando las horas. Pensé que Su señoría se había quedado leyendo hasta tarde, como tantas otras noches.",
   "archivo": "04_testimonio_cocinera.md"
  },
  {
   "id": "doncella",
   "titulo": "Testimonio de la doncella",
   "tipo": "testimonio",
   "autor": "Mary Pike",
   "fecha": "1894-11-15",
   "texto": "Pasé por el pasillo a las diez y veinte y vi luz bajo la puerta de la biblioteca. Pensé que Su señoría seguía leyendo y no llamé para no molestarle. No escuché voces ni ruidos dentro. Todo estaba en silencio y la casa parecía tranquila, igual que cualquier otra noche.",
   "archivo": "05_testimonio_doncella.md"
  },
  {
   "id": "botica",
   "titulo": "Recibo de la botica",
   "tipo": "recibo",
   "autor": "Botica Pemberton e Hijos",
   "fecha": "1894-11-09",
   "texto": "Botica Pemberton e Hijos. Se despachan diez gramos de extracto de belladona, para uso en preparados contra el insomnio y los dolores de cabeza. Pagado al contado. Firma del comprador: R. Hale, secretario de Marlowe Hall. El boticario advirtió de que el producto es peligroso en dosis elevadas.",
   "archivo": "06_recibo_botica.md"
  },
  {
   "id": "carta",
   "titulo": "Carta de Lord Aldridge a su abogado",
   "tipo": "carta",
   "autor": "Lord Edmund Aldridge",
   "fecha": "1894-11-12",
   "texto": "Estimado señor Whitcombe: he descubierto que mi secretario ha falsificado las cuentas de la finca durante dos años. Le ruego que venga el viernes para modificar mi testamento y que no lo comente con nadie. Prefiero resolver esto sin escándalo, pero no pienso volver a confiar en él.",
   "archivo": "07_carta_lord_aldridge.md"
  },
  {
   "id": "telegrama",
   "titulo": "Telegrama del inspector Lestrade",
   "tipo": "telegrama",
   "autor": "Inspector Lestrade",
   "fecha": "1894-11-15",
   "texto": "Holmes, el señor Hale asegura que pasó toda la noche en el club Albemarle. Tiene deudas de juego muy importantes con varios acreedores que le reclaman el pago. Ruego su ayuda urgente: la familia presiona y no logro avanzar.",
   "archivo": "08_telegrama_lestrade.md"
  },
  {
   "id": "watson",
   "titulo": "Diario del doctor Watson",
   "tipo": "diario",
   "autor": "Dr. Watson",
   "fecha": "1894-11-16",
   "texto": "Holmes examinó la licorera con su lupa y concluyó que el veneno se echó allí, y no en la copa, antes de las nueve y media. Lo hizo alguien que conocía bien la rutina de la casa. Junto a la puerta de servicio había barro con arena rojiza, la misma que cubre el camino de la finca.",
   "archivo": "09_diario_watson.md"
  },
  {
   "id": "club",
   "titulo": "Registro de salida del club Albemarle",
   "tipo": "registro",
   "autor": "Portero del club Albemarle",
   "fecha": "1894-11-14",
   "texto": "Libro de salidas, noche del catorce de noviembre. El señor R. Hale firmó su salida a las ocho y cuarenta y cinco y no volvió a entrar en el local. El portero recuerda que tomó un coche de alquiler en dirección a las afueras, hacia Marlowe Hall.",
   "archivo": "10_registro_club.md"
  },
  {
   "id": "cochero",
   "titulo": "Testimonio del cochero",
   "tipo": "testimonio",
   "autor": "Joseph Reed",
   "fecha": "1894-11-15",
   "texto": "Esperaba en el patio con el coche a las diez y media y vi luz en la ventana de la biblioteca. No vi entrar ni salir a nadie por la puerta principal. Todo estaba en calma y la ventana seguía iluminada cuando me retiré a dormir, pasada la medianoche.",
   "archivo": "11_testimonio_cochero.md"
  }
 ],
